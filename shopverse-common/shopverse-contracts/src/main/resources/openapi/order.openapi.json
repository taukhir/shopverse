  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or order state",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Idempotency or concurrent creation conflict",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "CheckoutItemRequest": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      },
      "ShippingAddressRequest": {
        "type": "object",
        "required": [
          "recipientName",
          "line1",
          "city",
          "state",
          "postalCode",
          "country"
        ],
        "properties": {
          "recipientName": {
            "type": "string",
            "maxLength": 160,
            "pattern": "(?s).*\\S.*"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true,
            "pattern": "^$|^[+]?[0-9]{10,15}$"
          },
          "line1": {
            "type": "string",
            "maxLength": 220,
            "pattern": "(?s).*\\S.*"
          },
          "line2": {
            "type": "string",
            "nullable": true,
            "maxLength": 220
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "pattern": "(?s).*\\S.*"
          },
          "state": {
            "type": "string",
            "maxLength": 100,
            "pattern": "(?s).*\\S.*"
          },
          "postalCode": {
            "type": "string",
            "maxLength": 30,
            "pattern": "(?s).*\\S.*"
          },
          "country": {
            "type": "string",
            "maxLength": 100,
            "pattern": "(?s).*\\S.*"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "items",
          "shippingAddress"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckoutItemRequest"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "Current checkout supports exactly one item; multi-item checkout is tracked separately as BUG-001."
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddressRequest"
          }
        }
      },
      "ShippingAddressResponse": {
        "type": "object",
        "properties": {
          "recipientName": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "line1": {
            "type": "string",
            "nullable": true
          },
          "line2": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "OrderItemResponse": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "type": "number"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "orderNumber": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "nullable": true
          },
          "idempotencyKey": {
            "type": "string",
            "nullable": true
          },
          "customerUsername": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "totalAmount": {
            "type": "number"
          },
          "shippingAddress": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ShippingAddressResponse"
              }
            ],
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderTimelineResponse": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "nullable": true
          },
          "stage": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderDeleteResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ServiceHealthResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CatalogItemResponse": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "productName": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "available": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "imageKey": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
