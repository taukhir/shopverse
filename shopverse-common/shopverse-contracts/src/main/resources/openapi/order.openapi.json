    "/api/v1/orders/checkout": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "checkout",
        "summary": "checkout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role or resource ownership"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "A required service is unavailable or the bulkhead is full"
          }
        },
        "description": "Requires CUSTOMER or ADMIN. Idempotency keys are scoped to the customer. A replay returns the original order with HTTP 201. Money remains a JSON number.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "(?s).*\\S.*"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        }
      }
    },
