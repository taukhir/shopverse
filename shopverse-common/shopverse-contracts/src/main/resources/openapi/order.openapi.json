        "operationId": "updateCheckout",
        "summary": "update Checkout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Repriced checkout and new version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role or resource ownership"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "description": "Submit the complete selections and reviewed checkoutVersion. A successful update returns the new version, recalculated price and expiry, whether or not the checkout had previously expired. Placed checkouts cannot be edited (409).",
        "parameters": [
          {
            "name": "checkoutId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCheckoutRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/checkouts/{checkoutId}/place-order": {
      "post": {
        "tags": [
          "Checkouts"
        ],
        "operationId": "placeOrder",
        "summary": "place Order",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Order created from the accepted checkout version; a replay with the same Idempotency-Key also returns this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role or resource ownership"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "A required service is unavailable or the bulkhead is full"
          }
        },
        "description": "Requires CUSTOMER or ADMIN. Idempotency keys are scoped to the checkout. A replay with the same key returns the original order, even after the checkout has expired. A stale checkoutVersion, an expired unplaced checkout, or reusing a different key on an already-placed checkout returns 409.",
        "parameters": [
          {
            "name": "checkoutId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "(?s).*\\S.*"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderRequest"
              }
            }
          }
        }
      }
    },
