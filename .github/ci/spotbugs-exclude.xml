<FindBugsFilter>
    <!-- Constructor-injected collaborators are deliberately shared Spring-managed instances.
         Copying a registry, configured ObjectMapper, KafkaTemplate, outbox or bound settings
         would break application-wide identity/configuration. None is returned to API callers.
         Match exact classes, fields and constructor findings; collection DTOs remain checked. -->
    <Match>
        <Class name="io.shopverse.platform.kafka.recovery.KafkaRecoveryService"/>
        <Method name="&lt;init&gt;"/>
        <Field name="~(meterRegistry|objectMapper|properties|replayOutbox)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.shopverse.platform.kafka.KafkaEventParser"/>
        <Method name="&lt;init&gt;"/>
        <Field name="objectMapper"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.shopverse.platform.observability.ShopverseRequestLoggingFilter"/>
        <Method name="&lt;init&gt;"/>
        <Field name="meterRegistry"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.shopverse.platform.outbox.ShopverseOutboxPublishWorker"/>
        <Method name="&lt;init&gt;"/>
        <Field name="~(kafkaTemplate|meterRegistry|properties)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.shopverse.platform.outbox.ShopverseOutboxPublisher"/>
        <Method name="&lt;init&gt;"/>
        <Field name="properties"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
