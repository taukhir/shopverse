{
  "type": "record",
  "name": "OrderCreatedEvent",
  "namespace": "io.shopverse.avro.order",
  "doc": "DRAFT for review, see context.md and discussions.md. Redesigned per BUG-001 option (a): carries all order line items in one event instead of a single scalar productId/quantity. Published once per order, after checkout persists order state and outbox intent in one local transaction.",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "UUID, unique per event instance. CORRECTED (per Codex/Product Manager review): this field alone does NOT implement deduplication. It's the necessary identity a consumer-side inbox needs to check against - the inbox table/logic (store processed eventIds, reject already-seen ones) is a separate implementation task, still open against the PROGRESS.md gap 'Transactional inbox/event-ID deduplication - Planned'."
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1,
      "doc": "Schema version marker so a consumer can branch explicitly instead of inferring from field presence."
    },
    {
      "name": "occurredAt",
      "type": { "type": "long", "logicalType": "timestamp-millis" }
    },
    {
      "name": "orderId",
      "type": "long"
    },
    {
      "name": "orderNumber",
      "type": "string"
    },
    {
      "name": "correlationId",
      "type": "string"
    },
    {
      "name": "customerUsername",
      "type": "string"
    },
    {
      "name": "currency",
      "type": "string",
      "default": "INR",
      "doc": "ISO 4217 currency code."
    },
    {
      "name": "totalAmount",
      "type": { "type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2 },
      "doc": "Order total. Decimal logical type, never double/float - see context.md for why."
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OrderLineItem",
          "fields": [
            { "name": "productId", "type": "long" },
            { "name": "quantity", "type": "int" },
            {
              "name": "unitPrice",
              "type": { "type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2 }
            }
          ]
        }
      }
    }
  ]
}
