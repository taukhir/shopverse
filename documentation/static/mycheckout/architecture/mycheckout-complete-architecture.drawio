        <mxCell id="legend" value="HOW TO READ&#10;Blue: application workloads / delivery&#10;Green: databases and durable storage&#10;Purple: asynchronous events / observability&#10;Orange: cache / external integration&#10;Amber dashed: provider or boundary not established&#10;Arrows show principal logical paths; secondary calls omitted on overview." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F6F8;strokeColor=#A4ADB9;fontColor=#20334B;fontSize=19;spacing=12;arcSize=10;" vertex="1" parent="1">
