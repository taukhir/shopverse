        <mxCell id="confirmed" value="SOURCE / CONFIG EVIDENCE&#10;Istio ingress gateway names and VirtualService values&#10;EKS service-account role annotations / network-policy values&#10;JWT exclusions / OPA source policies / authentication-context use&#10;DynamoDB stream filters for checkout and salesorder&#10;PostgreSQL stock_level connector / Kafka consumer and producer code&#10;Redis client calls / TTL / GEO operations&#10;OpenTelemetry endpoint / metrics annotations / Dynatrace configs&#10;GitHub workflows / Dockerfile / CDK pipeline configuration" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F4EB;strokeColor=#669A77;fontColor=#20334B;fontSize=19;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="570" width="1080" height="410" />
