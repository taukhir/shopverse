eight="35" /></mxCell><mxCell id="scope" value="Normal and large-payload branches are alternatives. A combined CDC/Lambda lane represents two source-specific connector stages, not one transaction spanning both stores." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="915" width="1370" height="75" /></mxCell></root></mxGraphModel></diagram><diagram name="18 Flow - Failure recovery, concurrency and repeat requests"><mxGraphModel page="1" pageWidth="1100" pageHeight="850" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Failure recovery, concurrency and repeat requests" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#18344D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="950" height="55" /></mxCell><mxCell id="n0" value="1. Detect failure / duplicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="110" width="410" height="58" /></mxCell><mxCell id="n1" value="2. Inspect durable current state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="192" width="410" height="58" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#087E8B;fontSize=12;" edge="1" parent="1" source="n0" target="n1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n2" value="3. Version conflict or stock race?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="274" width="410" height="58" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#087E8B;fontSize=12;" edge="1" parent="1" source="n1" target="n2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n3" value="4. Apply local guard / recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="356" width="410" height="58" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#087E8B;fontSize=12;" edge="1" parent="1" source="n2" target="n3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n4" value="5. Compensate applicable reservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="438" width="410" height="58" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#087E8B;fontSize=12;" edge="1" parent="1" source="n3" target="n4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n5" value="6. Reconcile provider + events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="520" width="410" height="58" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#087E8B;fontSize=12;" edge="1" parent="1" source="n4" target="n5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n6" value="7. Return truthful state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="602" width="410" height="58" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#087E8B;fontSize=12;" edge="1" parent="1" source="n5" target="n6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="branch" value="Branch / exception: Advisory locks do not protect a writer that ignores the protocol." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="120" width="450" height="135" /></mxCell><mxCell id="outcome" value="Result: A truthful returned failure/modification/current state, or a documented reconciliation requirement. Locking, optimistic versioning and idempotency solve different problems." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="300" width="450" height="170" /></mxCell><mxCell id="scope" value="This is an investigation/recovery map, not one universal executable transaction. Provider calls must not be inferred to run inside the PostgreSQL critical section merely from lane order." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="525" width="450" height="180" /></mxCell></root></mxGraphModel></diagram><diagram name="18 Sequence - Failure recovery, concurrency and repeat requests"><mxGraphModel page="1" pageWidth="1500" pageHeight="1050" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Failure recovery, concurrency and repeat requests" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#18344D;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="15" width="1400" height="55" /></mxCell><mxCell id="a0" value="Caller/event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="20.0" y="85" width="130" height="45" /></mxCell><mxCell id="l0" value="" style="strokeColor=#CBD9