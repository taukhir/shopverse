updated checkout or group with a new/current revision and applicable modifications. A child mutation can still involve persistence of the owning aggregate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="300" width="450" height="170" /></mxCell><mxCell id="scope" value="Address/tax messages are conditional capabilities, not mandatory calls on every patch. Child updates use a different local method from parent updates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="525" width="450" height="180" /></mxCell></root></mxGraphModel></diagram><diagram name="08 Sequence - Update checkout and child checkout"><mxGraphModel page="1" pageWidth="1500" pageHeight="1050" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Update checkout and child checkout" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#18344D;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="15" width="1400" height="55" /></mxCell><mxCell id="a0" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="20.0" y="85" width="130" height="45" /></mxCell><mxCell id="l0" value="" style="strokeColor=#CBD9E3;dashed=1;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="85.0" y="132" width="1" height="760" /></mxCell><mxCell id="a1" value="App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4F8;strokeColor=#CBD9E3;fontColor=#18344D;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="335.0" y="85" width="130" height="45" /></mxCell><mxCell id="l1" value="" style="strokeColor=#CBD9E3;dashed=1;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="400.0" y="132" width="1