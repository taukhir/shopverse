href":"#embedding-stores","class":"hash-link","aria-label":"Direct link to Embedding Stores","title":"Direct link to Embedding Stores","translate":"no"},"​"]],"\n",["P",{},"LangChain4j uses embedding stores for vector storage."],"\n",["P",{},"Responsibilities:"],"\n",["UL",{},"\n",["LI",{"class":""},"store text segments and embeddings"],"\n",["LI",{"class":""},"search similar segments"],"\n",["LI",{"class":""},"return content for RAG"],"\n"],"\n",["P",{},"For Shopverse:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"return-policy.md -> text segments -> embeddings -> embedding store"],["BR"]]]]]],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"result-metadata"},"Result Metadata",["A",{"href":"#result-metadata","class":"hash-link","aria-label":"Direct link to Result Metadata","title":"Direct link to Result Metadata","translate":"no"},"​"]],"\n",["P",{},"LangChain4j AI Services can return richer result wrappers with metadata such as:"],"\n",["UL",{},"\n",["LI",{"class":""},"token usage"],"\n",["LI",{"class":""},"retrieved sources"],"\n",["LI",{"class":""},"tool executions"],"\n",["LI",{"class":""},"finish reason"],"\n",["LI",{"class":""},"intermediate responses"],"\n"],"\n",["P",{},"This is useful for debugging and observability."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"langchain4j-with-spring-boot"},"LangChain4j With Spring Boot",["A",{"href":"#langchain4j-with-spring-boot","class":"hash-link","aria-label":"Direct link to LangChain4j With Spring Boot","title":"Direct link to LangChain4j With Spring Boot","translate":"no"},"​"]],"\n",["P",{},"LangChain4j has Spring Boot integration, so you can use it in Spring apps."],"\n",["P",{},"Possible Shopverse use:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"ai-service"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"  -> LangChain4j AI Service interface"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"  -> ProductTools"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"  -> RetrievalAugmentor"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"  -> Qdrant or PGVector embedding store"],["BR"]]]]]],"\n",["P",{},"However, if the interview is Spring-heavy, Spring AI is usually easier to\njustify first."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-to-master-first"},"What To Master First",["A",{"href":"#what-to-master-first","class":"hash-link","aria-label":"Direct link to What To Master First","title":"Direct link to What To Master First","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Priority"],["TH",{},"LangChain4j topic"]]],["TBODY",{},["TR",{},["TD",{},"P0"],["TD",{},"AI Services"]],["TR",{},["TD",{},"P0"],["TD",{},["CODE",{},"@SystemMessage"]," and ",["CODE",{},"@UserMessage"]]],["TR",{},["TD",{},"P0"],["TD",{},"structured return types"]],["TR",{},["TD",{},"P1"],["TD",{},"tools with ",["CODE",{},"@Tool"]]],["TR",{},["TD",{},"P1"],["TD",{},"memory basics"]],["TR",{},["TD",{},"P1"],["TD",{},["CODE",{},"RetrievalAugmentor"]]],["TR",{},["TD",{},"P2"],["TD",{},"tool search"]],["TR",{},["TD",{},"P2"],["TD",{},"result metadata"]],["TR",{},["TD",{},"P2"],["TD",{},"streaming"]]]],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"interview-qa"},"Interview Q&A",["A",{"href":"#interview-qa","class":"hash-link","aria-label":"Direct link to Interview Q&A","title":"Direct link to Interview Q&A","translate":"no"},"​"]],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-is-langchain4j"},"What is LangChain4j?",["A",{"href":"#what-is-langchain4j","class":"hash-link","aria-label":"Direct link to What is LangChain4j?","title":"Direct link to What is LangChain4j?","translate":"no"},"​"]],"\n",["P",{},"LangChain4j is a Java library for building LLM applications. It provides\nabstractions for chat models, AI Services, memory, tools, structured outputs,\nembedding stores, and RAG."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-are-ai-services"},"What are AI Services?",["A",{"href":"#what-are-ai-services","class":"hash-link","aria-label":"Direct link to What are AI Services?","title":"Direct link to What are AI Services?","translate":"no"},"​"]],"\n",["P",{},"AI Services let you define a Java interface, and LangChain4j creates a proxy\nimplementation backed by an LLM and optional memory, tools, RAG, and output\nparsing."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-is-retrievalaugmentor"},"What is ",["CODE",{},"RetrievalAugmentor"],"?",["A",{"href":"#what-is-retrievalaugmentor","class":"hash-link","aria-label":"Direct link to what-is-retrievalaugmentor","title":"Direct link to what-is-retrievalaugmentor","translate":"no"},"​"]],"\n",["P",{},"It is the entry point into LangChain4j's RAG pipeline. It augments a user\nmessage with relevant retrieved content before the model answers."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-is-tool"},"What is ",["CODE",{},"@Tool"],"?",["A",{"href":"#what-is-tool","class":"hash-link","aria-label":"Direct link to what-is-tool","title":"Direct link to what-is-tool","translate":"no"},"​"]],"\n",["P",{},["CODE",{},"@Tool"]," marks a Java method as callable by the model. The model can request the\ntool, but Java executes the method and controls validation and authorization."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"when-would-you-choose-langchain4j"},"When would you choose LangChain4j?",["A",{"href":"#when-would-you-choose-langchain4j","class":"hash-link","aria-label":"Direct link to When would you choose LangChain4j?","title":"Direct link to When would you choose LangChain4j?","translate":"no"},"​"]],"\n",["P",{},"I would choose it when I want interface-driven AI services, strong tool\npatterns, and a Java library that is not tied only to Spring AI abstractions."]]],["ASIDE",{"class":"feedback_Abhk","aria-label":"Documentation feedback"},["DIV",{},["STRONG",{},"Help improve this guide"],["SPAN",{},"Share the page or tell us what is unclear, outdated, or missing."]],["DIV",{"class":"actions_wZJ4"},["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-copy","aria-hidden":"true"},["rect",{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"}],["path",{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"}]],"Copy link"],["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-file-down","aria-hidden":"true"},["path",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["path",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["path",{"d":"M12 18v-6"}],["path",{"d":"m9 15 3 3 3-3"}]],"Export PDF"],["BU