6 2 2 4-4"}]],"Reviewed ","2026-07-11"]],["DIV",{"class":"readerActions_VXtU","aria-label":"Reader actions"},["BUTTON",{"class":"","type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-bookmark","aria-hidden":"true"},["path",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}]],"Bookmark"],["BUTTON",{"class":"","type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-check","aria-hidden":"true"},["path",{"d":"M20 6 9 17l-5-5"}]],"Mark complete"]],["ASIDE",{"class":"learningHeader__zab","aria-label":"Guide details"},["DIV",{"class":"badges_RAz0"},["SPAN",{},"Tutorial"],["SPAN",{},"Advanced"],["SPAN",{"class":"statusGeneric_JHRh"},"Generic"]],["DIV",{"class":"guideGrid_n85c"},["DIV",{},["STRONG",{},"Prerequisites"],["UL",{},["LI",{},"LLM prompting tools memory and RAG fundamentals"]]],["DIV",{},["STRONG",{},"What you will learn"],["UL",{},["LI",{},"Build production-oriented LangChain4j applications"],["LI",{},"Evaluate tools memory RAG and guardrail trade-offs"]]]],["DIV",{"class":"technologies_q4yp"},["SPAN",{},"LangChain4j"],["SPAN",{},"Java"],["SPAN",{},"RAG"]]],["DIV",{"class":"theme-doc-markdown markdown"},["HEADER",{},["H1",{},"LangChain4j Deep Dive"]],"\n",["P",{},"LangChain4j is a Java library for building LLM-powered applications. It is\nespecially useful to understand because it gives Java-friendly abstractions such\nas AI Services, tools, memory, structured outputs, and retrieval augmentors."],"\n",["P",{},"Official references:"],"\n",["UL",{},"\n",["LI",{"class":""},["A",{"href":"https://docs.langchain4j.dev/category/tutorials/","target":"_blank","rel":"noopener noreferrer","class":""},"LangChain4j tutorials"]],"\n",["LI",{"class":""},["A",{"href":"https://docs.langchain4j.dev/tutorials/ai-services/","target":"_blank","rel":"noopener noreferrer","class":""},"AI Services"]],"\n",["LI",{"class":""},["A",{"href":"https://docs.langchain4j.dev/tutorials/tools/","target":"_blank","rel":"noopener noreferrer","class":""},"Tools"]],"\n",["LI",{"class":""},["A",{"href":"https://docs.langchain4j.dev/tutorials/rag/","target":"_blank","rel":"noopener noreferrer","class":""},"RAG"]],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"why-langchain4j-exists"},"Why LangChain4j Exists",["A",{"href":"#why-langchain4j-exists","class":"hash-link","aria-label":"Direct link to Why LangChain4j Exists","title":"Direct link to Why LangChain4j Exists","translate":"no"},"​"]],"\n",["P",{},"The official introduction explains the core goal clearly: simplify integrating\nLLMs into Java applications."],"\n",["P",{},"The problem is that every model provider and vector store has its own API. If\nyour code directly depends on one provider's request/response shape, switching\nproviders becomes painful."],"\n",["P",{},"LangChain4j solves this with:"],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Goal"],["TH",{},"Meaning"]]],["TBODY",{},["TR",{},["TD",{},"unified APIs"],["TD",{},"use common Java abstractions across providers and ",["A",{"title":"Glossary: embedding","class":"","href":"/shopverse/reference/GLOSSARY#embedding"},"embedding"]," stores"]],["TR",{},["TD",{},"comprehensive toolbox"],["TD",{},"common LLM patterns are available as reusable components"]],["TR",{},["TD",{},"examples"],["TD",{},"many examples help developers start quickly"]]]],"\n",["P",{},"For Shopverse:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"Shopverse service code should not care deeply whether the model is OpenAI,"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"Ollama, Gemini, or another provider."],["BR"]]]]]],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"not-a-python-langchain-port"},"Not A Python LangChain Port",["A",{"href":"#not-a-python-langchain-port","class":"hash-link","aria-label":"Direct link to Not A Python LangChain Port","title":"Direct link to Not A Python LangChain Port","translate":"no"},"​"]],"\n",["P",{},"The intro explicitly says LangChain4j is not a Java port of Python LangChain.\nIt is designed around Java conventions:"],"\n",["UL",{},"\n",["LI",{"class":""},"type safety"],"\n",["LI",{"class":""},"POJOs"],"\n",["LI",{"class":""},"annotations"],"\n",["LI",{"class":""},"interfaces"],"\n",["LI",{"class":""},"dependency injection"],"\n",["LI",{"class":""},"fluent APIs"],"\n",["LI",{"class":""},"Spring Boot and other Java framework integrations"],"\n"],"\n",["P",{},"Interview line:"],"\n",["BLOCKQUOTE",{},"\n",["P",{},"LangChain4j borrows the general idea of LLM application building blocks, but\nit is written idiomatically for Java instead of being a direct Python port."],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"feature-map"},"Feature Map",["A",{"href":"#feature-map","class":"hash-link","aria-label":"Direct link to Feature Map","title":"Direct link to Feature Map","translate":"no"},"​"]],"\n",["P",{},"LangChain4j covers a broad set of LLM app features:"],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Feature"],["TH",{},"What it gives you"]]],["TBODY",{},["TR",{},["TD",{},"LLM provider integrations"],["TD",{},"connect to many chat model providers"]],["TR",{},["TD",{},"embedding model integrations"],["TD",{},"create vectors from text"]],["TR",{},["TD",{},"embedding/vector stores"],["TD",{},"store and search embeddings"]],["TR",{},["TD",{},"chat memory stores"],["TD",{},"keep conversation state"]],["TR",{},["TD",{},"prompt templates"],["TD",{},"reusable prompts"]],["TR",{},["TD",{},"streaming"],["TD",{},"incremental model responses"]],["TR",{},["TD",{},"output parsers"],["TD",{},"convert output to Java types and POJOs"]],["TR",{},["TD",{},"tools/function calling"],["TD",{},"call Java methods from model flow"]],["TR",{},["TD",{},"RAG ingestion"],["TD",{},"load, split, embed, and store documents"]],["TR",{},["TD",{},"RAG retrieval"],["TD",{},"query transformation, routing, retrieval, reranking"]],["TR",{},["TD",{},"agents"],["TD",{},"multi-step model/tool workflows"]],["TR",{},["TD",{},"moderation"],["TD",{},"unsafe-content checks where supported"]]]],"\n",["P",{},"Do not try to master all features first. Start with AI Services, structured\noutputs, tools, and RAG."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"low-level-vs-high-level-api"},"Low-Level vs High-Level API",["A",{"href":"#low-level-vs-high-level-api","class":"hash-link","aria-label":"Direct link to Low-Level vs High-Level API","title":"Direct link to Low-Level vs High-Level API","translate":"no"},"​"]],"\n",["P",{},["IMG",{"__playwright_current_src__":"data:image/svg+xml;base64,","decoding":"async","loading":"lazy","alt":"AI framework abstraction levels","src":"data:image/svg+xml;base64,","width":"1200","height":"650","class":"img_ev3q"}]],"\n",["P",{},"LangChain4j has two practical levels."],"\n",["P",{},"Low-level:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style