ss":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    "],["SPAN",{"class":"token class-name"},"Product"],["SPAN",{"class":"token plain"}," loaded "],["SPAN",{"class":"token operator","style":"color:#393A34"},"="],["SPAN",{"class":"token plain"}," repository"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"findRequired"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token plain"},"id"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},";"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    l2"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"put"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token plain"},"id"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},","],["SPAN",{"class":"token plain"}," loaded"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},","],["SPAN",{"class":"token plain"}," "],["SPAN",{"class":"token class-name"},"Duration"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"ofMinutes"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token number","style":"color:#36acaa"},"5"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},";"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    l1"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"put"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token plain"},"id"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},","],["SPAN",{"class":"token plain"}," loaded"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},";"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    "],["SPAN",{"class":"token keyword","style":"color:#00009f"},"return"],["SPAN",{"class":"token plain"}," loaded"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},";"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"}],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"}"],["BR"]]]]]],"\n",["P",{},"Add per-key request coalescing so concurrent misses do not all load the source.\nDo not hold a broad lock around an unbounded network call."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"ttl-relationship"},"TTL Relationship",["A",{"href":"#ttl-relationship","class":"hash-link","aria-label":"Direct link to TTL Relationship","title":"Direct link to TTL Relationship","translate":"no"},"​"]],"\n",["P",{},"L1 is normally shorter than L2—for example L1 seconds and L2 minutes, both with\njitter. This helps replicas converge while preserving shared reuse. Actual values\nmust come from business staleness limits and load tests."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"invalidation"},"Invalidation",["A",{"href":"#invalidation","class":"hash-link","aria-label":"Direct link to Invalidation","title":"Direct link to Invalidation","translate":"no"},"​"]],"\n",["OL",{},"\n",["LI",{"class":""},"Commit the authoritative change."],"\n",["LI",{"class":""},"Publish a durable domain/outbox event."],"\n",["LI",{"class":""},"Cache owners consume it idempotently."],"\n",["LI",{"class":""},"Evict/update L2 and each consumer's own L1."],"\n",["LI",{"class":""},"TTL bounds damage from delayed/missed events."],"\n"],"\n",["P",{},"Redis Pub/Sub is fast but not durable for disconnected consumers. A durable\nbroker supports replay but adds lag, ordering, and contract concerns. A coarse\nversion token can make old L1 keys unreachable:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"L2 catalog:version -> 381"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"L1 product:42:version:381"],["BR"]]]]]],"\n",["P",{},"Old generations still require bounded expiry."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"microservice-ownership"},"Microservice Ownership",["A",{"href":"#microservice-ownership","class":"hash-link","aria-label":"Direct link to Microservice Ownership","title":"Direct link to Microservice Ownership","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},"A service owns caches derived from its data or contract."],"\n",["LI",{"class":""},"Consumers do not delete arbitrary keys in another service's namespace."],"\n",["LI",{"class":""},"Publish domain facts; each consumer invalidates its representation."],"\n",["LI",{"class":""},"Separate environment/service prefixes, credentials, and ACLs."],"\n",["LI",{"class":""},"Do not add a generic HTTP cache service merely to wrap Redis."],"\n",["LI",{"class":""},"Do not share internal serialized DTOs across bounded contexts accidentally."],"\n"],"\n",["P",{},"A shared cache reduces replica disagreement but does not make the database and\ncache atomic. Network partitions, failover, delayed events, and concurrent writes\nstill race. Read the authoritative source when stale data is unacceptable."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"failure-policies"},"Failure Policies",["A",{"href":"#failure-policies","class":"hash-link","aria-label":"Direct link to Failure Policies","title":"Direct link to Failure Policies","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Failure"],["TH",{},"Possible policy"],["TH",{},"Trade-off"]]],["TBODY",{},["TR",{},["TD",{},"L1 miss/failure"],["TD",{},"Bypass to L2"],["TD",{},"Higher network load"]],["TR",{},["TD",{},"L2 timeout"],["TD",{},"Bypass to source"],["TD",{},"May overload source"]],["TR",{},["TD",{},"L2 outage with safe L1"],["TD",{},"Serve bounded stale"],["TD",{},"Availability over freshness"]],["TR",{},["TD",{},"L2 outage for authorization"],["TD",{},"Fail closed or authoritative read"],["TD",{},"Security over availability"]],["TR",{},["TD",{},"Source outage"],["TD",{},"Serve explicitly bounded stale"],["TD",{},"Must accept/communicate staleness"]],["TR",{},["TD",{},"All layers cold"],["TD",{},"Limit concurrency and warm gradually"],["TD",{},"Slower recovery protects source"]]]],"\n",["P",{},"Cache timeout should consume a small part of the request deadline. Avoid retries\nat client, resilience, and proxy layers for the same operation."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"stampede-controls"},"Stampede Controls",["A",{"href":"#stampede-controls","class":"hash-link","aria-label":"Direct link to Stampede Controls","title":"Direct link to Stampede Controls","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},"Single-flight same-key loads inside each replica."],"\n",["LI",{"class":""},"TTL jitter and refresh-ahead for predictable hot keys."],"\n",["LI",{"class":""},"Bounded stale-while-one-caller-refreshes behavior."],"\n",["LI",{"class":""},"Miss concurrency limits/load shedding to protect the source."],"\n",["LI",{"class":""},"Warm only measured hot keys, not the whole database."],"\n",["LI",{"class":""},"Use a distributed lease only when duplicate cross-replica loads are harmful;\nleases require ownership, expiry, and sometimes fencing."],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"multi-region-and-deployment"},"Multi-Region And Deployment",["A",{"href":"#multi-region-and-deployment","class":"hash-link","aria-label":"Direct link to Multi-Region And Deployment","title":"Direct link to Multi-Region And Deployment","translate":"no"},"​"]],"\n",["P",{},"Avoid synchronous cache access across distant regions. Prefer region-local\ncaches with explicit replication/invalidation and staleness. Define failover\nwarmup and regional key ownership."],"\n",["P",{},"During rolling deployment old and new instances share L2 values. Use a compatible\nschema, versioned key namespace, or time-bounded dual-read/write migration. Never\nmake Java object serialization an undocumented distributed contract."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"test-matrix"},"Test Matrix",["A",{"href":"#test-matrix","class":"hash-link","aria-label":"Direct link to Test Matrix","title":"Direct link to Test Matrix","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},"L1 hit, L2 hit, total miss, negative result, and expiration."],"\n",["LI",{"class":""},"Concurrent same-key misses and hot-key traffic."],"\n",["LI",{"class":""},"Update/invalidation at every replica, including delayed duplicate events."],"\n",["LI",{"class":""},"Redis timeout/outage, cold restart, and source overload protection."],"\n",["LI",{"class":""},"Old/new value formats during rolling deployment."],"\n",["LI",{"class":""},"Tenant and authorization key isolation."],"\n",["LI",{"class":""},"TTL avalanche, memory eviction, and recovery warmup."],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"related-guides"},"Related Guides",["A",{"href":"#related-guides","class":"hash-link","aria-label":"Direct link to Related Guides","title":"Direct link to Related Guides","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},["A",{"class":"","href":"/shopverse/architecture/CACHE-UMBRELLA"},"Cache Umbrella"]],"\n",["LI",{"class":""},["A",{"class":"","href":"/shopverse/architecture/CACHE-PROVIDERS"},"Cache Providers"]],"\n",["LI",{"class":""},["A",{"class":"","href":"/shopverse/reliability/OUTBOX-PATTERN"},"Transactional Outbox"]],"\n",["LI",{"class":""},["A",{"class":"","href":"/shopverse/reliability/locking/DISTRIBUTED-LOCKS-AND-FENCING"},"Distributed Locks And Fencing"]],"\n"]]],["ASIDE",{"class":"feedback_Abhk","aria-label":"Documentation feedback"},["DIV",{},["STRONG",{},"Help improve this guide"],["SPAN",{},"Share the page or tell us what is unclear, outdated, or missing."]],["DIV",{"class":"actions_wZJ4"},["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-copy","aria-hidden":"true"},["rect",{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"}],["path",{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"}]],"Copy link"],["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-file-down","aria-hidden":"true"},["path",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["path",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["path",{"d":"M12 18v-6"}],["path",{"d":"m9 15 3 3 3-3"}]],"Export PDF"],["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke"