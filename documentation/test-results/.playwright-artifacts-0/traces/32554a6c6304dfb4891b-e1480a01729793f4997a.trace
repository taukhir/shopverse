k to Default And Custom Selection","translate":"no"},"​"]],"\n",["P",{},"Spring Cloud LoadBalancer commonly uses a Round Robin implementation unless\nconfiguration or a custom load-balancer bean selects another strategy. Do not\nassume least-connections or latency-aware balancing without implementing it."],"\n",["P",{},"A custom random strategy can be selected per service:"],"\n",["DIV",{"class":"language-java codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-java codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token annotation punctuation","style":"color:#393A34"},"@Configuration"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"}],["SPAN",{"class":"token keyword","style":"color:#00009f"},"public"],["SPAN",{"class":"token plain"}," "],["SPAN",{"class":"token keyword","style":"color:#00009f"},"class"],["SPAN",{"class":"token plain"}," "],["SPAN",{"class":"token class-name"},"InventoryLoadBalancerConfiguration"],["SPAN",{"class":"token plain"}," "],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"{"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain","style":"display:inline-block"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    "],["SPAN",{"class":"token annotation punctuation","style":"color:#393A34"},"@Bean"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    "],["SPAN",{"class":"token class-name"},"ReactorLoadBalancer"],["SPAN",{"class":"token generics punctuation","style":"color