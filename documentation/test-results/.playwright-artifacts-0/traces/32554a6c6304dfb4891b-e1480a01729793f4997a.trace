hash-link","aria-label":"Direct link to Read In This Order","title":"Direct link to Read In This Order","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Goal"],["TH",{},"Page"]]],["TBODY",{},["TR",{},["TD",{},"Understand levels, patterns, keys, storage, and consistency"],["TD",{},"This page"]],["TR",{},["TD",{},"Use Spring annotations and proxy behavior"],["TD",{},["A",{"class":"","href":"/shopverse/spring/SPRING-CACHE"},"Spring Cache"]]],["TR",{},["TD",{},"Compare Caffeine, Redis, and Memcached"],["TD",{},["A",{"class":"","href":"/shopverse/architecture/CACHE-PROVIDERS"},"Cache Providers"]]],["TR",{},["TD",{},"Design L1/L2 and hybrid caching"],["TD",{},["A",{"class":"","href":"/shopverse/architecture/DISTRIBUTED-HYBRID-CACHE"},"Distributed And Hybrid Cache"]]],["TR",{},["TD",{},"Understand persistence-context, Hibernate L2, and query cache"],["TD",{},["A",{"class":"","href":"/shopverse/data/hibernate/HIBERNATE-CACHING"},"Hibernate Caching"]]]]],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-level-1-and-level-2-mean"},"What “Level 1” And “Level 2” Mean",["A",{"href":"#what-level-1-and-level-2-mean","class":"hash-link","aria-label":"Direct link to What “Level 1” And “Level 2” Mean","title":"Direct link to What “Level 1” And “Level 2” Mean","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Context"],["TH",{},"L1"],["TH",{},"L2"]]],["TBODY",{},["TR",{},["TD",{},"Hybrid application cache"],["TD",{},"Per-instance local cache such as Caffeine"],["TD",{},"Shared remote cache such as Redis"]],["TR",{},["TD",{},"Hibernate"],["TD",{},"Mandatory persistence-context cache in one ",["CODE",{},"EntityManager"]],["TD",{},"Optional cache shared across sessions"]],["TR",{},["TD",{},"CPU hardware"],["TD",{},"Small cache closest to a core"],["TD",{},"Larger cache shared more broadly"]]]],"\n",["P",{},"Always name the context. Hibernate L1 is not Caffeine, and Redis used by a\nmicroservice is not automatically Hibernate's second-level cache."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"cache-layers"},"Cache Layers",["A",{"href":"#cache-layers","class":"hash-link","aria-label":"Direct link to Cache Layers","title":"Direct link to Cache Layers","translate":"no"},"​"]],"\n","\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Layer"],["TH",{},"Scope"],["TH",{},"Best use"],["TH",{},"Main risk"]]],["TBODY",{},["TR",{},["TD",{},"Browser/HTTP"],["TD",{},"Client/intermediary"],["TD",{},"Cacheable HTTP representations"],["TD",{},"Private data or incorrect headers"]],["TR",{},["TD",{},"CDN/edge"],["TD",{},"Regions/users"],["TD",{},"Assets and public cacheable responses"],["TD",{},"Purge delay and wrong cache key"]],["TR",{},["TD",{},"Application local"],["TD",{},"One process"],["TD",{},"Extremely hot tolerant data"],["TD",{},"Replicas disagree; duplicate memory"]],["TR",{},["TD",{},"Distributed"],["TD",{},"Many processes"],["TD",{},"Shared reusable values"],["TD",{},"Network dependency and outage"]],["TR",{},["TD",{},"ORM first-level"],["TD",{},"One unit of work"],["TD",{},"Entity identity and repeat loads"],["TD",{},"Confusing managed state with durable data"]],["TR",{},["TD",{},"ORM second-level"],["TD",{},"Application/provider region"],["TD",{},"Reusable entity/collection state"],["TD",{},"Stale data and invalidation complexity"]],["TR",{},["TD",{},"Database buffer pool"],["TD",{},"Database"],["TD",{},"Frequently used pages and indexes"],["TD",{},"Does not fix inefficient queries"]]]],"\n",["P",{},"The layers form a hierarchy, not a requirement to enable every cache. Each added\nlayer needs an owner, key definition, maximum staleness, invalidation/TTL,\nstampede protection, observability, and a safe miss/outage path. A useful visual\nprompt for this topic is the ",["A",{"href":"https://www.linkedin.com/posts/codingwithroby_great-backend-engineers-understand-caching-activity-7475141017277562880-md7l/","target":"_blank","rel":"noopener noreferrer","class":""},"layered-caching source supplied with this request"],"."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"how-data-is-stored"},"How Data Is Stored",["A",{"href":"#how-data-is-stored","class":"hash-link","aria-label":"Direct link to How Data Is Stored","title":"Direct link to How Data Is Stored","translate":"no"},"​"]],"\n",["P",{},"Conceptually:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"cache name/namespace + key -> encoded value + expiration + provider metadata"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain","style":"display:inline-block"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"shopverse:catalog:v3:product:42"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"  -> {\"id\":42,\"name\":\"Keyboard\",\"price\":4999}"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"  TTL: 300 seconds"],["BR"]]]]]],"\n",["UL",{},"\n",["LI",{"class":""},["STRONG",{},"Local cache:"]," key/value are Java objects in process memory; serialization\nis usually unnecessary, but shared mutable objects are dangerous."],"\n",["LI",{"class":""},["STRONG",{},"Redis/Memcached:"]," key/value cross the network as bytes. The application\nchooses String, JSON, protobuf, or another serializer."],"\n",["LI",{"class":""},["STRONG",{},"Hibernate L2:"]," the provider stores entity state by region and identifier,\nnot an attached entity object shared across sessions."],"\n"],"\n",["P",{},"Remote values form a deployment contract. Version the namespace or keep\nserialization backward compatible. Never put secrets or raw personal data in\nkeys; keys appear in logs, metrics, and administrative tools."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"cache-keys"},"Cache Keys",["A",{"href":"#cache-keys","class":"hash-link","aria-label":"Direct link to Cache Keys","title":"Direct link to Cache Keys","translate":"no"},"​"]],"\n",["P",{},"A key must include every input that changes the result:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"{service}:{cache}:{schemaVersion}:{tenant}:{locale}:{authorizationVariant}:{id}"],["BR"]]]]]],"\n",["P",{},"Ask whether tenant, currency, locale, page, sort, permissions, or representation\nversion matters. Keys must be deterministic and bounded. Avoid random request IDs\nunless implementing deduplication with a strict TTL."],"\n",["P",{},"Spring's default key is ",["CODE",{},"SimpleKey.EMPTY"]," for no arguments, the argument itself\nfor one argument, and a ",["CODE",{},"SimpleKey"]," of all arguments for several. Use an explicit\nkey or ",["CODE",{},"KeyGenerator"]," when parameters contain unstable/irrelevant fields."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"core-patterns"},"Core Patterns",["A",{"href":"#core-patterns","class":"hash-link","aria-label":"Direct link to Core Patterns","title":"Direct link to Core Patterns","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Pattern"],["TH",{},"Flow"],["TH",{},"Main trade-off"]]],["TBODY",{},["TR",{},["TD",{},"Cache-aside"],["TD",{},"App loads source after miss, then stores"],["TD",{},"Simple; concurrent misses can stampede"]],["TR",{},["TD",{},"Read-through"],["TD",{},"Cache invokes a loader"],["TD",{},"Provider-specific loading contract"]],["TR",{},["TD",{},"Write-through"],["TD",{},"Write cache and source synchronously"],["TD",{},"Latency; two systems are not automatically atomic"]],["TR",{},["TD",{},"Write-behind"],["TD",{},"Cache persists asynchronously"],["TD",{},"Durability, ordering, and recovery complexity"]],["TR",{},["TD",{},"Refresh-ahead"],["TD",{},"Refresh before expiry"],["TD",{},"Extra work and temporary staleness"]],["TR",{},["TD",{},"Stale-while-revalidate"],["TD",{},"Serve bounded stale while refreshing"],["TD",{},"Availability over freshness"]]]],"\n","\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"expiration-eviction-and-invalidation"},"Expiration, Eviction, And Invalidation",["A",{"href":"#expiration-eviction-and-invalidation","class":"hash-link","aria-label":"Direct link to Expiration, Eviction, And Invalidation","title":"Direct link to Expiration, Eviction, And Invalidation","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},["STRONG",{},"Expire-after-write/TTL:"]," age since load or write."],"\n",["LI",{"class":""},["STRONG",{},"Expire-after-access/time-to-idle:"]," time since last access."],"\n",["LI",{"class":""},["STRONG",{},"Size/weight eviction:"]," remove entries when memory capacity is reached."],"\n",["LI",{"class":""},["STRONG",{},"Manual invalidation:"]," remove/replace affected keys after authoritative write."],"\n",["LI",{"class":""},["STRONG",{},"Namespace version:"]," make an incompatible key family unreachable."],"\n"],"\n",["P",{},"TTL is a safety net, not complete consistency. Too long serves stale values; too\nshort destroys hit rate. Add jitter when many keys would otherwise expire together."],"\n",["P",{},"Cache and database updates are usually not atomic:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"T1 database commit succeeds"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"T2 cache still contains old value"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"T3 invalidation arrives"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"T4 next read reloads the new value"],["BR"]]]]]],"\n",["P",{},"Define the acceptable T1–T3 staleness window. For cross-service invalidation,\npublish a durable outbox/domain event and consume it idempotently."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"common-failures"},"Common Failures",["A",{"href":"#common-failures","class":"hash-link","aria-label":"Direct link to Common Failures","title":"Direct link to Common Failures","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Problem"],["TH",{},"Effect"],["TH",{},"Controls"]]],["TBODY",{},["TR",{},["TD",{},"Stampede/thundering herd"],["TD",{},"Many callers reload one key"],["TD",{},"Single-flight/",["CODE",{},"sync"],", jitter, refresh-ahead"]],["TR",{},["TD",{},"Penetration"],["TD",{},"Repeated absent keys reach source"],["TD",{},"Validation, brief negative caching, Bloom filter when justified"]],["TR",{},["TD",{},"Avalanche"],["TD",{},"Many keys expire or cache fails together"],["TD",{},"Jitter, load shedding, controlled warmup"]],["TR",{},["TD",{},"Hot key"],["TD",{},"One key overloads one node"],["TD",{},"L1 near-cache, replication, split/redesign value"]],["TR",{},["TD",{},"Pollution"],["TD",{},"Low-value entries evict hot entries"],["TD",{},"Admission/weight limits and targeted caches"]],["TR",{},["TD",{},"Stale authorization"],["TD",{},"Revoked access remains cached"],["TD",{},"Complete key, short TTL, invalidation, fail-closed policy"]],["TR",{},["TD",{},"Poisoned value"],["TD",{},"Old/bad schema cannot decode"],["TD",{},"Version prefix, guarded serializer, delete-on-decode failure"]],["TR",{},["TD",{},"Cache outage"],["TD",{},"Source receives full traffic"],["TD",{},"Short timeout, no retry storm, capacity protection"]]]],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"what-not-to-cache"},"What Not To Cache",["A",{"href":"#what-not-to-cache","class":"hash-link","aria-label":"Direct link to What Not To Cache","title":"Direct link to What Not To Cache","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},"failures disguised as valid empty results;"],"\n",["LI",{"class":""},"mutable correctness-critical inventory without an accepted stale window;"],"\n",["LI",{"class":""},"authorization without full subject, tenant, resource, and policy version;"],"\n",["LI",{"class":""},"huge values more expensive to serialize than recompute;"],"\n",["LI",{"class":""},"one-use unbounded keys;"],"\n",["LI",{"class":""},"secrets or data the cache security boundary cannot protect;"],"\n",["LI",{"class":""},"values whose invalidation costs more than the original operation."],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"measurement-and-checklist"},"Measurement And Checklist",["A",{"href":"#measurement-and-checklist","class":"hash-link","aria-label":"Direct link to Measurement And Checklist","title":"Direct link to Measurement And Checklist","translate":"no"},"​"]],"\n",["P",{},"Measure hits, misses, load latency/failure, eviction, size/weight, remote command\nlatency/errors, source load during outage, and business correctness. Hit rate\nalone can hide expensive misses."],"\n",["P",{},"Before caching, answer:"],"\n",["OL",{},"\n",["LI",{"class":""},"What expensive work is avoided and by how much?"],"\n",["LI",{"class":""},"What is authoritative and how stale may the copy be?"],"\n",["LI",{"class":""},"What forms the complete key?"],"\n",["LI",{"class":""},"Who invalidates after every write path?"],"\n",["LI",{"class":""},"What bounds memory/cardinality?"],"\n",["LI",{"class":""},"What happens during cache outage and cold start?"],"\n",["LI",{"class":""},"Can the source survive misses and recovery?"],"\n",["LI",{"class":""},"How are values evolved, secured, tested, and monitored?"],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"official-references"},"Official References",["A",{"href":"#official-references","class":"hash-link","aria-label":"Direct link to Official References","title":"Direct link to Official References","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},["A",{"href":"https://docs.spring.io/spring-framework/reference/integration/cache.html","target":"_blank","rel":"noopener noreferrer","class":""},"Spring Cache Abstraction"]],"\n",["LI",{"class":""},["A",{"href":"https://docs.spring.io/spring-boot/reference/io/caching.html","target":"_blank","rel":"noopener noreferrer","class":""},"Spring Boot Caching"]],"\n"]]],["ASIDE",{"class":"feedback_Abhk","aria-label":"Documentation feedback"},["DIV",{},["STRONG",{},"Help improve this guide"],["SPAN",{},"Share the page or tell us what is unclear, outdated, or missing."]],["DIV",{"class":"actions_wZJ4"},["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-copy","aria-hidden":"true"},["rect",{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"}],["path",{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"}]],"Copy link"],["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"