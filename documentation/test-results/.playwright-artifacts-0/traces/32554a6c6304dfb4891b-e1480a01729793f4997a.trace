lor:#393A34"},"("],["SPAN",{"class":"token number","style":"color:#36acaa"},"10_000"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"            "],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"expireAfterWrite"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token class-name"},"Duration"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"ofMinutes"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token number","style":"color:#36acaa"},"5"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"            "],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"."],["SPAN",{"class":"token function","style":"color:#d73a49"},"recordStats"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"("],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},")"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},";"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"    "],["SPAN",{"class":"token keyword","style":"color:#00009f"},"return"],["SPAN",{"class":"token plain"}," manager"],["SPAN",{"class":"token punctuation","style":"color:#393A34"},";"],["SPAN",{"class":"token plain"}],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"}],["SPAN",{"class":"token punctuation","style":"color:#393A34"},"}"],["BR"]]]]]],"\n",["UL",{},"\n",["LI",{"class":""},"Bound by ",["CODE",{},"maximumSize"],", or ",["CODE",{},"maximumWeight"]," plus a weigher."],"\n",["LI",{"class":""},"Choose expiry from the freshness budget; removal is not a real-time scheduler."],"\n",["LI",{"class":""},["CODE",{},"refreshAfterWrite"]," needs a loading strategy and refreshes on eligible access."],"\n",["LI",{"class":""},["CODE",{},"recordStats()"]," enables statistics with some overhead."],"\n",["LI",{"class":""},"Cache immutable DTOs/defensive copies, not caller-mutated objects."],"\n",["LI",{"class":""},"Every replica warms, expires, and invalidates independently."],"\n"],"\n",["P",{},"Choose Caffeine for extremely hot, read-heavy data when brief per-replica\ninconsistency is acceptable. Restart clearing it must be safe."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"redis"},"Redis",["A",{"href":"#redis","class":"hash-link","aria-label":"Direct link to Redis","title":"Direct link to Redis","translate":"no"},"​"]],"\n",["P",{},"Redis is a remote in-memory data-structure server. Spring Cache normally maps a\nnamespaced key to serialized bytes with a TTL; direct Redis use can also access\nhashes, sets, sorted sets, streams, counters, and atomic server operations."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"redis-serialization-protocol-resp"},"Redis Serialization Protocol (RESP)",["A",{"href":"#redis-serialization-protocol-resp","class":"hash-link","aria-label":"Direct link to Redis Serialization Protocol (RESP)","title":"Direct link to Redis Serialization Protocol (RESP)","translate":"no"},"​"]],"\n",["P",{},"Clients use RESP over persistent TCP connections. A command is an array of bulk\nstrings and the response is a typed RESP2/RESP3 value."],"\n",["P",{},"Conceptual ",["CODE",{},"GET product:42"]," request:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"*2\\r\\n"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"$3\\r\\n"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"GET\\r\\n"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"$10\\r\\n"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"product:42\\r\\n"],["BR"]]]]]],"\n",["P",{},"RESP transports commands; JSON/protobuf/JDK serialization is a separate value\ncodec choice. Use a maintained Lettuce/Jedis client, not hand-written protocol."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"redis-production-controls"},"Redis Production Controls",["A",{"href":"#redis-production-controls","class":"hash-link","aria-label":"Direct link to Redis Production Controls","title":"Direct link to Redis Production Controls","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},"Configure ",["CODE",{},"maxmemory"]," and an intentional eviction policy for cache workloads."],"\n",["LI",{"class":""},"Distinguish TTL expiration from memory-pressure eviction."],"\n",["LI",{"class":""},"Use private networking, TLS, ACLs/authentication, and per-service credentials."],"\n",["LI",{"class":""},"Bound connect, pool-acquisition, command, and total timeouts."],"\n",["LI",{"class":""},"Avoid layered retries that consume the request deadline."],"\n",["LI",{"class":""},"Plan replication/failover and understand possible recent-data loss/lag."],"\n",["LI",{"class":""},"Treat values as rebuildable even when persistence is enabled."],"\n",["LI",{"class":""},"Monitor hits, misses, evictions, expirations, memory, latency, blocked clients,\nconnections, rejected writes, and replication."],"\n"],"\n",["P",{},"Prefer explicit JSON or a governed binary schema over unversioned Java\nserialization. Restrict polymorphic deserialization and version namespaces."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"memcached"},"Memcached",["A",{"href":"#memcached","class":"hash-link","aria-label":"Direct link to Memcached","title":"Direct link to Memcached","translate":"no"},"​"]],"\n",["P",{},"Memcached is a distributed disposable memory cache. Clients commonly select a\nserver through consistent hashing. Each item contains a key, expiration, flags,\nCAS value, and opaque bytes. Operations include ",["CODE",{},"get"],", ",["CODE",{},"set"],", ",["CODE",{},"add"],", ",["CODE",{},"replace"],",\n",["CODE",{},"delete"],", increment/decrement, and compare-and-swap."],"\n",["P",{},"Current Memcached guidance recommends the Meta Text Protocol for new advanced\nclients; the binary protocol is deprecated. Consider:"],"\n",["UL",{},"\n",["LI",{"class":""},"key/item-size constraints and serialization;"],"\n",["LI",{"class":""},"slab allocation and LRU expiration/eviction behavior;"],"\n",["LI",{"class":""},"client distribution when servers join or leave;"],"\n",["LI",{"class":""},"stampede/stale-while-revalidate support;"],"\n",["LI",{"class":""},"private networking and access isolation;"],"\n",["LI",{"class":""},"hit, miss, eviction, item, byte, connection, and latency statistics."],"\n"],"\n",["P",{},"Spring Boot does not include Memcached in its built-in cache-provider detection.\nUse a maintained client plus a tested adapter/third-party ",["CODE",{},"CacheManager"],"."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"selecting-a-provider"},"Selecting A Provider",["A",{"href":"#selecting-a-provider","class":"hash-link","aria-label":"Direct link to Selecting A Provider","title":"Direct link to Selecting A Provider","translate":"no"},"​"]],"\n","\n",["P",{},"Benchmark full serialization, network, failure, and source-protection behavior."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"official-references"},"Official References",["A",{"href":"#official-references","class":"hash-link","aria-label":"Direct link to Official References","title":"Direct link to Official References","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},["A",{"href":"https://github.com/ben-manes/caffeine/wiki","target":"_blank","rel":"noopener noreferrer","class":""},"Caffeine Wiki"]],"\n",["LI",{"class":""},["A",{"href":"https://redis.io/docs/latest/develop/reference/protocol-spec/","target":"_blank","rel":"noopener noreferrer","class":""},"Redis Protocol"]],"\n",["LI",{"class":""},["A",{"href":"https://redis.io/docs/latest/develop/reference/eviction/","target":"_blank","rel":"noopener noreferrer","class":""},"Redis Eviction"]],"\n",["LI",{"class":""},["A",{"href":"https://docs.memcached.org/protocols/","target":"_blank","rel":"noopener noreferrer","class":""},"Memcached Protocols"]],"\n"]]],["ASIDE",{"class":"feedback_Abhk","aria-label":"Documentation feedback"},["DIV",{},["STRONG",{},"Help improve this guide"],["SPAN",{},"Share the page or tell us what is unclear, outdated, or missing."]],["DIV",{"class":"actions_wZJ4"},["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-copy","aria-hidden":"true"},["rect",{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"}],["path",{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"}]],"Copy link"],["BUTTON",{"type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class