alse","tabindex":"0","href":"/shopverse/integration/MESSAGING-PLATFORM-SELECTION"},["SPAN",{"title":"Messaging","class":"categoryLinkLabel_W154"},"Messaging"]]]],["LI",{"class":"theme-doc-sidebar-item-link theme-doc-sidebar-item-link-level-2 menu__list-item"},["A",{"class":"menu__link","tabindex":"0","href":"/shopverse/reference/DISTRIBUTED-SYSTEMS-INTERVIEW"},["SPAN",{"title":"Distributed Systems Interview Questions","class":"linkLabel_WmDU"},"Distributed Systems Interview Questions"]]]]],["LI",{"class":"theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item menu__list-item--collapsed"},["DIV",{"class":"menu__list-item-collapsible"},["A",{"class":"categoryLink_byQd menu__link menu__link--sublist menu__link--sublist-caret","role":"button","aria-expanded":"false","href":"/shopverse/security/principles/SECURITY-PRINCIPLES"},["SPAN",{"title":"6. Security","class":"categoryLinkLabel_W154"},"6. Security"]]]],["LI",{"class":"theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item menu__list-item--collapsed"},["DIV",{"class":"menu__list-item-collapsible"},["A",{"class":"categoryLink_byQd menu__link menu__link--sublist menu__link--sublist-caret","role":"button","aria-expanded":"false","href":"/shopverse/observability/LOGGING-GENERIC"},["SPAN",{"title":"7. Logging And Observability","class":"categoryLinkLabel_W154"},"7. Logging And Observability"]]]],["LI",{"class":"theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item menu__list-item--collapsed"},["DIV",{"class":"menu__list-item-collapsible"},["A",{"class":"categoryLink_byQd menu__link menu__link--sublist menu__link--sublist-caret","role":"button","aria-expanded":"false","href":"/shopverse/operations/"},["SPAN",{"title":"8. Delivery, Containers And CI/CD","class":"categoryLinkLabel_W154"},"8. Delivery, Containers And CI/CD"]]]],["LI",{"class":"theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item menu__list-item--collapsed"},["DIV",{"class":"menu__list-item-collapsible"},["A",{"class":"categoryLink_byQd menu__link menu__link--sublist menu__link--sublist-caret","role":"button","aria-expanded":"false","href":"/shopverse/cloud/"},["SPAN",{"title":"9. Cloud And AWS","class":"categoryLinkLabel_W154"},"9. Cloud And AWS"]]]],["LI",{"class":"theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item menu__list-item--collapsed"},["DIV",{"class":"menu__list-item-collapsible"},["A",{"class":"categoryLink_byQd menu__link menu__link--sublist menu__link--sublist-caret","role":"button","aria-expanded":"false","href":"/shopverse/ai/"},["SPAN",{"title":"10. AI, RAG And Java AI","class":"categoryLinkLabel_W154"},"10. AI, RAG And Java AI"]]]],["LI",{"class":"theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item menu__list-item--collapsed"},["DIV",{"class":"menu__list-item-collapsible"},["A",{"class":"categoryLink_byQd menu__link menu__link--sublist menu__link--sublist-caret","role":"button","aria-expanded":"false","href":"/shopverse/case-study/SHOPVERSE"},["SPAN",{"title":"11. Shopverse Implementation","class":"categoryLinkLabel_W154"},"11. Shopverse Implementation"]]]]]],["BUTTON",{"type":"button","title":"Collapse sidebar","aria-label":"Collapse sidebar","class":"button button--secondary button--outline collapseSidebarButton_PEFL"},["svg",{"width":"20","height":"20","aria-hidden":"true","class":"collapseSidebarButtonIcon_kv0_"},["g",{"fill":"#7a7a7a"},["path",{"d":"M9.992 10.023c0 .2-.062.399-.172.547l-4.996 7.492a.982.982 0 01-.828.454H1c-.55 0-1-.453-1-1 0-.2.059-.403.168-.551l4.629-6.942L.168 3.078A.939.939 0 010 2.528c0-.548.45-.997 1-.997h2.996c.352 0 .649.18.828.45L9.82 9.472c.11.148.172.347.172.55zm0 0"}],["path",{"d":"M19.98 10.023c0 .2-.058.399-.168.547l-4.996 7.492a.987.987 0 01-.828.454h-3c-.547 0-.996-.453-.996-1 0-.2.059-.403.168-.551l4.625-6.942-4.625-6.945a.939.939 0 01-.168-.55 1 1 0 01.996-.997h3c.348 0 .649.18.828.45l4.996 7.492c.11.148.168.347.168.55zm0 0"}]]]]]]],["MAIN",{"class":"docMainContainer_TBSr"},["DIV",{"class":"container padding-top--md padding-bottom--lg"},["DIV",{"class":"row"},["DIV",{"class":"col docItemCol_VOVn"},["DIV",{"class":"docItemContainer_Djhp"},["ARTICLE",{},["NAV",{"class":"theme-doc-breadcrumbs breadcrumbsContainer_Z_bl","aria-label":"Breadcrumbs"},["UL",{"class":"breadcrumbs"},["LI",{"class":"breadcrumbs__item"},["A",{"aria-label":"Home page","class":"breadcrumbs__link","href":"/shopverse/"},["svg",{"viewBox":"0 0 24 24","class":"breadcrumbHomeIcon_YNFT"},["path",{"d":"M10 19v-5h4v5c0 .55.45 1 1 1h3c.55 0 1-.45 1-1v-7h1.7c.46 0 .68-.57.33-.87L12.67 3.6c-.38-.34-.96-.34-1.34 0l-8.36 7.53c-.34.3-.13.87.33.87H5v7c0 .55.45 1 1 1h3c.55 0 1-.45 1-1z","fill":"currentColor"}]]]],["LI",{"class":"breadcrumbs__item"},["SPAN",{"class":"breadcrumbs__link"},"5. Microservices And Distributed Systems"]],["LI",{"class":"breadcrumbs__item"},["SPAN",{"class":"breadcrumbs__link"},"Architecture Basics"]],["LI",{"class":"breadcrumbs__item breadcrumbs__item--active"},["SPAN",{"class":"breadcrumbs__link"},"Load Balancing"]]]],["DIV",{"class":"tocCollapsible_ETCw theme-doc-toc-mobile tocMobile_ITEo"},["BUTTON",{"type":"button","class":"clean-btn tocCollapsibleButton_TO0P"},"On this page"]],["DIV",{},["DIV",{"class":"metadata_mp1T reading-metadata","aria-label":"Reading information"},["SPAN",{},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-clock3","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["polyline",{"points":"12 6 12 12 16.5 12"}]],"Calculating reading time"]],["DIV",{"class":"readerActions_VXtU","aria-label":"Reader actions"},["BUTTON",{"class":"","type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-bookmark","aria-hidden":"true"},["path",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}]],"Bookmark"],["BUTTON",{"class":"","type":"button"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-check","aria-hidden":"true"},["path",{"d":"M20 6 9 17l-5-5"}]],"Mark complete"]],["DIV",{"class":"theme-doc-markdown markdown"},["HEADER",{},["H1",{},"Load Balancing"]],"\n",["P",{},"Load balancing distributes work across multiple service instances so one\ninstance does not receive all traffic. It improves availability, throughput,\nmaintenance flexibility, and horizontal scaling."],"\n","\n",["P",{},"A load balancer should select only instances considered available. Selection\nand health detection are separate concerns: an algorithm decides ",["EM",{},"which"],"\ninstance to use, while discovery and health checks decide ",["EM",{},"which instances are\neligible"],"."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"why-load-balancing-matters"},"Why Load Balancing Matters",["A",{"href":"#why-load-balancing-matters","class":"hash-link","aria-label":"Direct link to Why Load Balancing Matters","title":"Direct link to Why Load Balancing Matters","translate":"no"},"​"]],"\n",["UL",{},"\n",["LI",{"class":""},"spreads requests across available capacity;"],"\n",["LI",{"class":""},"removes failed or draining instances from selection;"],"\n",["LI",{"class":""},"permits rolling deployments;"],"\n",["LI",{"class":""},"supports horizontal scaling;"],"\n",["LI",{"class":""},"reduces dependence on one host;"],"\n",["LI",{"class":""},"provides a stable logical destination for changing instances."],"\n"],"\n",["P",{},"Load balancing does not make an application stateless, idempotent, or\nresilient automatically. Shared state, retries, timeouts, database capacity,\nand failure isolation still require explicit design."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"server-side-load-balancing"},"Server-Side Load Balancing",["A",{"href":"#server-side-load-balancing","class":"hash-link","aria-label":"Direct link to Server-Side Load Balancing","title":"Direct link to Server-Side Load Balancing","translate":"no"},"​"]],"\n",["P",{},"Clients connect to a dedicated proxy or managed load balancer:"],"\n","\n",["P",{},"Advantages:"],"\n",["UL",{},"\n",["LI",{"class":""},"clients know one stable endpoint;"],"\n",["LI",{"class":""},"policies and certificates are centralized;"],"\n",["LI",{"class":""},"works with clients that do not understand service discovery."],"\n"],"\n",["P",{},"Trade-offs:"],"\n",["UL",{},"\n",["LI",{"class":""},"adds a network hop;"],"\n",["LI",{"class":""},"the load-balancer tier must itself be redundant;"],"\n",["LI",{"class":""},"centralized capacity and configuration must be managed."],"\n"],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"client-side-load-balancing"},"Client-Side Load Balancing",["A",{"href":"#client-side-load-balancing","class":"hash-link","aria-label":"Direct link to Client-Side Load Balancing","title":"Direct link to Client-Side Load Balancing","translate":"no"},"​"]],"\n",["P",{},"The calling application obtains service instances from discovery and selects\none locally:"],"\n","\n",["P",{},"Advantages:"],"\n",["UL",{},"\n",["LI",{"class":""},"no separate proxy hop between services;"],"\n",["LI",{"class":""},"integrates naturally with logical service names;"],"\n",["LI",{"class":""},"each caller can apply dependency-specific policy."],"\n"],"\n",["P",{},"Trade-offs:"],"\n",["UL",{},"\n",["LI",{"class":""},"every client runtime needs compatible discovery and balancing support;"],"\n",["LI",{"class":""},"stale discovery caches can temporarily select an unavailable instance;"],"\n",["LI",{"class":""},"observability and policy are distributed across callers."],"\n"],"\n",["P",{},"Spring Cloud LoadBalancer is a client-side load balancer."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"layer-4-and-layer-7"},"Layer 4 And Layer 7",["A",{"href":"#layer-4-and-layer-7","class":"hash-link","aria-label":"Direct link to Layer 4 And Layer 7","title":"Direct link to Layer 4 And Layer 7","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Type"],["TH",{},"Operates on"],["TH",{},"Typical decisions"]]],["TBODY",{},["TR",{},["TD",{},"Layer 4"],["TD",{},"TCP/UDP connection data"],["TD",{},"IP, port, connection count"]],["TR",{},["TD",{},"Layer 7"],["TD",{},"HTTP/application data"],["TD",{},"path, host, header, method, cookie"]]]],"\n",["P",{},"Layer 4 is protocol-light and efficient. Layer 7 can make API-aware decisions\nbut performs more processing and must understand the application protocol."],"\n",["P",{},"Spring Cloud Gateway performs Layer 7 routing. A cloud or ingress load\nbalancer may sit in front of gateway replicas."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"selection-algorithms"},"Selection Algorithms",["A",{"href":"#selection-algorithms","class":"hash-link","aria-label":"Direct link to Selection Algorithms","title":"Direct link to Selection Algorithms","translate":"no"},"​"]],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"round-robin"},"Round Robin",["A",{"href":"#round-robin","class":"hash-link","aria-label":"Direct link to Round Robin","title":"Direct link to Round Robin","translate":"no"},"​"]],"\n",["P",{},"Selects instances in sequence:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"A -> B -> C -> A -> B -> C"],["BR"]]]]]],"\n",["P",{},"Best when instances have similar capacity and requests have roughly similar\ncost. It is simple and predictable but does not consider current load."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"weighted-round-robin"},"Weighted Round Robin",["A",{"href":"#weighted-round-robin","class":"hash-link","aria-label":"Direct link to Weighted Round Robin","title":"Direct link to Weighted Round Robin","translate":"no"},"​"]],"\n",["P",{},"Instances receive traffic proportional to configured weights:"],"\n",["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"A weight 3, B weight 1 -> A, A, A, B"],["BR"]]]]]],"\n",["P",{},"Useful when instance sizes differ or during gradual rollout. Incorrect weights\ncan overload smaller instances."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"random"},"Random",["A",{"href":"#random","class":"hash-link","aria-label":"Direct link to Random","title":"Direct link to Random","translate":"no"},"​"]],"\n",["P",{},"Selects a random healthy instance. It is simple and performs reasonably with\nlarge request volumes, but short windows can be uneven."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"least-connections"},"Least Connections",["A",{"href":"#least-connections","class":"hash-link","aria-label":"Direct link to Least Connections","title":"Direct link to Least Connections","translate":"no"},"​"]],"\n",["P",{},"Selects the instance with the fewest active connections. It suits\nlong-lived or uneven requests better than basic Round Robin."],"\n",["P",{},"It requires accurate connection-state tracking and does not account for\ndifferent instance capacities unless weighted."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"weighted-least-connections"},"Weighted Least Connections",["A",{"href":"#weighted-least-connections","class":"hash-link","aria-label":"Direct link to Weighted Least Connections","title":"Direct link to Weighted Least Connections","translate":"no"},"​"]],"\n",["P",{},"Combines active connections with instance capacity. Larger instances can\naccept more concurrent work."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"least-response-time"},"Least Response Time",["A",{"href":"#least-response-time","class":"hash-link","aria-label":"Direct link to Least Response Time","title":"Direct link to Least Response Time","translate":"no"},"​"]],"\n",["P",{},"Selects based on observed latency, often combined with active connections.\nThis can adapt to slow instances, but measurements need smoothing to avoid\nrapidly shifting traffic."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"consistent-hashing"},"Consistent Hashing",["A",{"href":"#consistent-hashing","class":"hash-link","aria-label":"Direct link to Consistent Hashing","title":"Direct link to Consistent Hashing","translate":"no"},"​"]],"\n",["P",{},"Hashes a stable key onto a ring of instances. When instances change, only part\nof the key space moves."],"\n","\n",["P",{},"Useful for cache locality, sharded ownership, or sticky workloads. It can\ncreate hot spots when keys are uneven and should not replace durable shared\nstate."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"ip-hash"},"IP Hash",["A",{"href":"#ip-hash","class":"hash-link","aria-label":"Direct link to IP Hash","title":"Direct link to IP Hash","translate":"no"},"​"]],"\n",["P",{},"Hashes the source IP to choose an instance. It provides weak affinity but can\nbe skewed by NAT, proxies, or mobile network changes."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"power-of-two-choices"},"Power Of Two Choices",["A",{"href":"#power-of-two-choices","class":"hash-link","aria-label":"Direct link to Power Of Two Choices","title":"Direct link to Power Of Two Choices","translate":"no"},"​"]],"\n",["P",{},"Randomly samples two instances and selects the less loaded one. It achieves\ngood balancing with less global coordination than scanning every instance."],"\n",["H3",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"sticky-sessions"},"Sticky Sessions",["A",{"href":"#sticky-sessions","class":"hash-link","aria-label":"Direct link to Sticky Sessions","title":"Direct link to Sticky Sessions","translate":"no"},"​"]],"\n",["P",{},"Routes a client to the same instance using a cookie, source property, or hash.\nAffinity can help legacy session-based applications but reduces even\ndistribution and complicates failover."],"\n",["P",{},"Prefer stateless services and shared session storage when possible."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"algorithm-comparison"},"Algorithm Comparison",["A",{"href":"#algorithm-comparison","class":"hash-link","aria-label":"Direct link to Algorithm Comparison","title":"Direct link to Algorithm Comparison","translate":"no"},"​"]],"\n",["TABLE",{},["THEAD",{},["TR",{},["TH",{},"Algorithm"],["TH",{},"Strength"],["TH",{},"Limitation"],["TH",{},"Typical use"]]],["TBODY",{},["TR",{},["TD",{},"Round Robin"],["TD",{},"simple and fair over time"],["TD",{},"ignores current load"],["TD",{},"similar stateless instances"]],["TR",{},["TD",{},"Weighted Round Robin"],["TD",{},"handles unequal capacity"],["TD",{},"weights need maintenance"],["TD",{},"mixed instance sizes, canary rollout"]],["TR",{},["TD",{},"Random"],["TD",{},"low coordination"],["TD",{},"short-term imbalance"],["TD",{},"large homogeneous pools"]],["TR",{},["TD",{},"Least Connections"],["TD",{},"reacts to active work"],["TD",{},"needs connection tracking"],["TD",{},"long-lived connections"]],["TR",{},["TD",{},"Least Response Time"],["TD",{},"reacts to latency"],["TD",{},"measurement oscillation"],["TD",{},"variable backend performance"]],["TR",{},["TD",{},"Consistent Hashing"],["TD",{},"preserves key locality"],["TD",{},"hot keys and rebalancing complexity"],["TD",{},"caches and partition ownership"]],["TR",{},["TD",{},"Power of Two Choices"],["TD",{},"good balance at low cost"],["TD",{},"needs load signal"],["TD",{},"large dynamic pools"]],["TR",{},["TD",{},"Sticky Sessions"],["TD",{},"session affinity"],["TD",{},"weaker failover and balance"],["TD",{},"legacy stateful applications"]]]],"\n",["P",{},"There is no universally best algorithm. Choose using request duration,\ninstance capacity, state locality, health signal quality, and operational\ncomplexity."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"health-and-discovery"},"Health And Discovery",["A",{"href":"#health-and-discovery","class":"hash-link","aria-label":"Direct link to Health And Discovery","title":"Direct link to Health And Discovery","translate":"no"},"​"]],"\n","\n",["P",{},"Common mechanisms:"],"\n",["UL",{},"\n",["LI",{"class":""},"active health checks sent by a proxy;"],"\n",["LI",{"class":""},"passive failure detection from real requests;"],"\n",["LI",{"class":""},"registry heartbeats and lease expiry;"],"\n",["LI",{"class":""},"readiness probes;"],"\n",["LI",{"class":""},"connection draining during shutdown;"],"\n",["LI",{"class":""},"cached discovery results with a bounded lifetime."],"\n"],"\n",["P",{},"Readiness should remove an instance before shutdown so in-flight requests can\nfinish without new traffic arriving."],"\n",["H2",{"class":"anchor anchorTargetStickyNavbar_Vzrq","id":"spring-cloud-loadbalancer"},"Spring Cloud LoadBalancer",["A",{"href":"#spring-cloud-loadbalancer","class":"hash-link","aria-label":"Direct link to Spring Cloud LoadBalancer","title":"Direct link to Spring Cloud LoadBalancer","translate":"no"},"​"]],"\n",["P",{},"Spring Cloud LoadBalancer provides client-side service-instance selection for\nSpring Cloud clients."],"\n",["P",{},"Typical dependencies for LoadBalancer, Eureka discovery, and declarative HTTP clients:"],"\n",["DIV",{"class":"theme-tabs-container tabs-container tabList__CuJ"},["UL",{"role":"tablist","aria-orientation":"horizontal","class":"tabs"},["LI",{"role":"tab","tabindex":"0","aria-selected":"true","class":"tabs__item tabItem_LNqP tabs__item--active"},"Maven"],["LI",{"role":"tab","tabindex":"-1","aria-selected":"false","class":"tabs__item tabItem_LNqP"},"Gradle"]],["DIV",{"class":"margin-top--md"},["DIV",{"role":"tabpanel","class":"tabItem_Ymn6"},["DIV",{"class":"language-text codeBlockContainer_Ckt0 theme-code-block","style":"--prism-color:#393A34;--prism-background-color:#f6f8fa"},["DIV",{"class":"codeBlockContent_QJqH"},["PRE",{"tabindex":"0","class":"prism-code language-text codeBlock_bY9V thin-scrollbar","style":"color:#393A34;background-color:#f6f8fa"},["CODE",{"class":"codeBlockLines_e6Vv"},["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"<dependency>"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"<groupId>org.springframework.cloud</groupId>"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"<artifactId>spring-cloud-starter-loadbalancer</artifactId>"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"</dependency>"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"<dependency>"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",{"class":"token plain"},"<groupId>org.springframework.cloud</groupId>"],["BR"]],["DIV",{"class":"token-line","style":"color:#393A34"},["SPAN",