#!/bin/sh
set -eu

commit_message_file=${1:?commit message file is required}
first_line=$(sed -n '1p' "$commit_message_file")

if ! printf '%s\n' "$first_line" | grep -Eq '^\[[A-Z][A-Z0-9]*-[A-Z0-9]+\] : .+'; then
  printf '%s\n' 'Invalid commit message.' 'Expected: [JIRA-ID] : commit message' 'Example: [BUG-003] : cover multi-item checkout' >&2
  exit 1
fi
