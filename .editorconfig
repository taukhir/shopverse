root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle}]
indent_style = tab
indent_size = 4

[*.java]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,mjs,js,ts,html,css}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[gradlew]
end_of_line = lf

[gradlew.bat]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,jar,zip}]
insert_final_newline = false
trim_trailing_whitespace = false
